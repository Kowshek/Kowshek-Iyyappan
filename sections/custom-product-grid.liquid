{% comment %}
  CUSTOM PRODUCT GRID SECTION
  - Displays 6 products
  - Opens a Popup
  - Handles "Black + Medium" Trap Logic
{% endcomment %}

<div class="custom-product-grid section-{{ section.id }}">
  <div class="grid-container">
    {% if section.settings.title != blank %}
      <h2 class="grid-title">{{ section.settings.title }}</h2>
    {% endif %}

    <div class="product-grid">
      {%- assign products_to_show = section.settings.product_list -%}

      {%- if products_to_show != blank -%}
        {%- for product in products_to_show -%}
          <div class="product-card">
            <div class="card-image">
              {% if product.featured_image %}
                <img
                  src="{{ product.featured_image | image_url: width: 600 }}"
                  alt="{{ product.title }}"
                  loading="lazy"
                  width="600"
                  height="600"
                >
              {% else %}
                {{ 'product-1' | placeholder_svg_tag }}
              {% endif %}
            </div>
            {% comment %} <div class="card-info">
              <h3>{{ product.title }}</h3>
              <p>{{ product.price | money }}</p>
                <button class="btn-view-details"
                  data-id="{{ product.id }}"
                  data-title="{{ product.title | escape }}"
                  data-price="{{ product.price | money }}"
                  data-desc="{{ product.description | escape }}"
                  onclick="openProductPopup(this)">
                  View Details
                </button>

              <div class="hidden-variants-data" id="variants-{{ product.id }}" style="display:none;">
                [
                {%- for variant in product.variants -%}
                  { "id": {{ variant.id }}, "title": "{{ variant.title | escape }}", "option1": "
                  {{- variant.option1 | escape -}}
                  ", "option2": "{{ variant.option2 | escape }}", "price": "{{ variant.price | money }}" }
                  {%- unless forloop.last %},{% endunless %}
                {%- endfor -%}
                ]
              </div>
            </div> {% endcomment %}
          </div>
        {%- endfor -%}
      {%- else -%}
        <p style="text-align: center;">Please select products in the Customize menu.</p>
      {%- endif -%}
    </div>
  </div>
</div>

<div id="product-popup" class="popup-overlay" style="display: none;">
  <div class="popup-content">
    <button class="close-btn" onclick="closePopup()">&times;</button>
    <div class="popup-body">
      <h2 id="popup-title">Product Title</h2>
      <p id="popup-price">$0.00</p>
      <div id="popup-description"></div>

      <label for="variant-select">Choose Option:</label>
      <select id="variant-select" class="variant-dropdown"></select>

      <button id="add-to-cart-btn" class="btn-add-cart">Add to Cart</button>
      <p id="feedback-msg"></p>
    </div>
  </div>
</div>

<style>
  /* CONTAINER & TITLE */
  .custom-product-grid {
    padding: 60px 0;
    background-color: #ffffff;
  }

  .grid-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 20px;
  }

  .grid-title {
    text-align: center;
    font-size: 36px;
    font-weight: 700;
    margin-bottom: 40px;
    text-transform: uppercase;
    letter-spacing: 1px;
  }

  /* THE GRID LAYOUT */
  .product-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr); /* Standard 3-column layout */
    gap: 30px;
  }

  /* PRODUCT CARD STYLING */
  .product-card {
    background: #fff;
    border: 1px solid #e1e1e1;
    border-radius: 8px;
    overflow: hidden;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
    display: flex;
    flex-direction: column;
  }

  .product-card:hover {
    transform: translateY(-5px);
    box-shadow: 0 10px 20px rgba(0, 0, 0, 0.1);
  }

  .card-image {
    position: relative;
    width: 100%;
    padding-top: 100%; /* Forces a square aspect ratio */
    overflow: hidden;
    background-color: #f9f9f9;
  }

  .card-image img {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover; /* Ensures image fills the square without distortion */
    transition: transform 0.5s ease;
  }

  .product-card:hover .card-image img {
    transform: scale(1.05); /* Subtle zoom effect on hover */
  }

  .card-info {
    padding: 20px;
    text-align: center;
    flex-grow: 1;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }

  .card-info h3 {
    font-size: 18px;
    font-weight: 600;
    margin: 0 0 10px;
    color: #333;
  }

  .card-info p {
    font-size: 16px;
    color: #666;
    font-weight: 500;
    margin-bottom: 15px;
  }

  /* BUTTONS */
  .btn-view-details {
    background-color: #000;
    color: #fff;
    border: none;
    padding: 12px 24px;
    font-size: 14px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 1px;
    cursor: pointer;
    border-radius: 4px; /* Slight rounding - safe bet */
    width: 100%;
    transition: background-color 0.3s ease;
  }

  .btn-view-details:hover {
    background-color: #333;
  }

  /* POPUP STYLES */
  .popup-overlay {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(0, 0, 0, 0.6);
    z-index: 9999;
    display: flex;
    justify-content: center;
    align-items: center;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.3s ease;
  }

  /* When active, show popup */
  .popup-overlay[style*='display: flex'] {
    opacity: 1;
    pointer-events: auto;
  }

  .popup-content {
    background: #fff;
    padding: 40px;
    width: 90%;
    max-width: 500px;
    border-radius: 8px;
    position: relative;
    text-align: left;
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.2);
  }

  .close-btn {
    position: absolute;
    top: 15px;
    right: 20px;
    font-size: 30px;
    background: none;
    border: none;
    cursor: pointer;
    color: #999;
    transition: color 0.3s;
  }

  .close-btn:hover {
    color: #000;
  }

  .variant-dropdown {
    width: 100%;
    padding: 12px;
    border: 1px solid #ddd;
    border-radius: 4px;
    margin: 20px 0;
    font-size: 16px;
  }

  .btn-add-cart {
    width: 100%;
    background-color: #000;
    color: #fff;
    padding: 15px;
    border: none;
    font-size: 16px;
    font-weight: bold;
    text-transform: uppercase;
    cursor: pointer;
    transition: opacity 0.3s;
  }

  .btn-add-cart:hover {
    opacity: 0.9;
  }

  /* RESPONSIVE DESIGN */
  @media (max-width: 990px) {
    .product-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 576px) {
    .product-grid {
      grid-template-columns: 1fr;
    }
    .grid-title {
      font-size: 28px;
    }
  }
</style>

<script>
  let selectedVariantId = null;

  function openProductPopup(btn) {
    // 1. Get Data from Button Attributes
    const title = btn.getAttribute('data-title');
    const price = btn.getAttribute('data-price');
    const desc = btn.getAttribute('data-desc'); // Note: HTML might be escaped
    const productId = btn.getAttribute('data-id');

    // 2. Populate Popup UI
    document.getElementById('popup-title').innerText = title;
    document.getElementById('popup-price').innerText = price;
    // Basic unescape for description if needed, or just text
    document.getElementById('popup-description').innerHTML = desc;

    // 3. Get Variants Data
    const variantsDiv = document.getElementById('variants-' + productId);
    const variants = JSON.parse(variantsDiv.textContent);

    // 4. Build Dropdown
    const select = document.getElementById('variant-select');
    select.innerHTML = '';

    variants.forEach((v, index) => {
      const option = document.createElement('option');
      option.value = v.id;
      option.text = `${v.title} - ${v.price}`;

      // Store options for the "Trap" logic
      option.setAttribute('data-opt1', (v.option1 || '').toLowerCase());
      option.setAttribute('data-opt2', (v.option2 || '').toLowerCase());

      select.appendChild(option);
      if (index === 0) selectedVariantId = v.id;
    });

    // Update selected ID on change
    select.onchange = function () {
      selectedVariantId = this.value;
    };

    // Show Popup
    document.getElementById('product-popup').style.display = 'flex';
  }

  function closePopup() {
    document.getElementById('product-popup').style.display = 'none';
  }

  // --- TRAP LOGIC ---
  document.getElementById('add-to-cart-btn').addEventListener('click', function (e) {
    e.preventDefault();
    if (!selectedVariantId) return;

    const select = document.getElementById('variant-select');
    const selectedOption = select.options[select.selectedIndex];

    const opt1 = selectedOption.getAttribute('data-opt1');
    const opt2 = selectedOption.getAttribute('data-opt2');

    // CHECK: Is it Black AND Medium? (Order doesn't matter)
    const isTrap =
      (opt1 === 'black' && (opt2 === 'medium' || opt2 === 'm')) ||
      (opt2 === 'black' && (opt1 === 'medium' || opt1 === 'm'));

    const items = [{ id: selectedVariantId, quantity: 1 }];

    if (isTrap) {
      console.log('Trap Triggered: Attempting to add gift...');
      // Hardcode the ID for "Soft Winter Jacket" if you know it.
      // If not, we try to fetch it or just alert for now.
      // REPLACE THIS ID WITH THE REAL ONE FROM YOUR CSV IMPORT IF YOU HAVE IT
      // For now, let's just log it.
      // items.push({ id: 123456789, quantity: 1 });
    }

    // Add to Cart Fetch
    fetch(window.Shopify.routes.root + 'cart/add.js', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ items: items }),
    })
      .then((response) => response.json())
      .then((data) => {
        document.getElementById('feedback-msg').innerText = 'Added to Cart!';
        document.getElementById('feedback-msg').style.color = 'green';
        setTimeout(closePopup, 1500);
      })
      .catch((error) => {
        console.error('Error:', error);
        document.getElementById('feedback-msg').innerText = 'Error.';
        document.getElementById('feedback-msg').style.color = 'red';
      });
  });
</script>

{% schema %}
{
  "name": "Custom Product Grid",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Grid Title",
      "default": "Our Collection"
    },
    {
      "type": "product_list",
      "id": "product_list",
      "label": "Select Products",
      "limit": 6
    }
  ],
  "presets": [
    {
      "name": "Custom Product Grid"
    }
  ]
}
{% endschema %}
