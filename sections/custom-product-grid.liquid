<div class="custom-product-grid section-{{ section.id }}">
  <div class="grid-container">
    {% if section.settings.title != blank %}
      <h2 class="grid-title">{{ section.settings.title }}</h2>
    {% endif %}

    <div class="product-grid">
      {%- assign products_to_show = section.settings.product_list -%}

      {%- if products_to_show != blank -%}
        {%- for product in products_to_show -%}
          <div class="grid-item">
            <div class="card-image">
              {% if product.featured_image %}
                <img
                  src="{{ product.featured_image | image_url: width: 800 }}"
                  alt="{{ product.title }}"
                  loading="lazy"
                  width="800"
                  height="800"
                >
              {% else %}
                {{ 'product-1' | placeholder_svg_tag }}
              {% endif %}

              <button
                class="hotspot-btn"
                onclick="openProductPopup({{ product.id }})"
                aria-label="View {{ product.title }}"
              >
                <span>+</span>
              </button>
            </div>

            <script id="data-{{ product.id }}" type="application/json">
              {
                "id": {{ product.id }},
                "title": "{{ product.title | escape }}",
                "price": "{{ product.price | money_without_trailing_zeros }}",
                "description": "{{ product.description | strip_html | truncatewords: 25 | escape }}",
                "image": "{{ product.featured_image | image_url: width: 400 }}",
                "variants": [
                  {%- for variant in product.variants -%}
                    {
                      "id": {{ variant.id }},
                      "title": "{{ variant.title | escape }}",
                      "option1": "{{ variant.option1 | escape }}",
                      "option2": "{{ variant.option2 | escape }}",
                      "price": "{{ variant.price | money_without_trailing_zeros }}"
                    }{%- unless forloop.last %},{% endunless %}
                  {%- endfor -%}
                ]
              }
            </script>
          </div>
        {%- endfor -%}
      {%- else -%}
        <p style="text-align: center;">Please select products in the Customize menu.</p>
      {%- endif -%}
    </div>
  </div>
</div>

<div id="product-popup" class="popup-overlay" style="display: none;">
  <div class="popup-box">
    <button class="close-btn" onclick="closePopup()" aria-label="Close">&times;</button>

    <div class="popup-header-row">
      <div class="popup-small-img">
        <img id="popup-img" src="" alt="Product Preview" width="150" height="150">
      </div>

      <div class="popup-header-info">
        <h2 id="popup-title">Product Title</h2>
        <p id="popup-price">$0.00</p>
        <div id="popup-desc" class="popup-desc"></div>
      </div>
    </div>

    <div class="popup-form-row">
      <div class="selector-group">
        <label class="selector-label">Color</label>
        <div id="color-options-container" class="color-options"></div>
      </div>

      <div class="selector-group">
        <label class="selector-label">Size</label>
        <div id="custom-size-wrapper" class="custom-size-selector">
          <div class="size-trigger" id="size-trigger">
            <span id="size-selected-text">Choose your size</span>
            <div class="size-arrow">
              <svg width="14" height="9" viewBox="0 0 14 9" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M1 1.5L7 7.5L13 1.5" stroke="black" stroke-width="1.5"/>
              </svg>
            </div>
          </div>

          <ul class="size-dropdown-list" id="size-dropdown-list"></ul>
        </div>
      </div>

      <button id="add-to-cart-btn" class="btn-add-cart">
        <span>ADD TO CART</span>
        <span class="btn-arrow-long">
          <svg width="30" height="10" viewBox="0 0 30 10" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M0 5H29M29 5L25 1M29 5L25 9" stroke="white" stroke-width="1.5"/>
          </svg>
        </span>
      </button>
      <p id="feedback-msg"></p>
    </div>
  </div>
</div>

