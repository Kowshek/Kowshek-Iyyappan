{% comment %}
  CUSTOM PRODUCT GRID SECTION - LOOKBOOK STYLE
  - Displays 6 products as pure images
  - "Hotspot" (+) icon triggers popup
  - Handles "Black + Medium" Trap Logic
{% endcomment %}

<div class="custom-product-grid section-{{ section.id }}">
  <div class="grid-container">
    {% if section.settings.title != blank %}
      <h2 class="grid-title">{{ section.settings.title }}</h2>
    {% endif %}

    <div class="product-grid">
      {%- assign products_to_show = section.settings.product_list -%}

      {%- if products_to_show != blank -%}
        {%- for product in products_to_show -%}
          <div class="product-card">
            <div class="card-image">
              {% if product.featured_image %}
                <img
                  src="{{ product.featured_image | image_url: width: 800 }}"
                  alt="{{ product.title }}"
                  loading="lazy"
                  width="800"
                  height="800"
                >
              {% else %}
                {{ 'product-1' | placeholder_svg_tag }}
              {% endif %}

              <button class="hotspot-btn"
                data-id="{{ product.id }}"
                data-title="{{ product.title | escape }}"
                data-price="{{ product.price | money }}"
                data-desc="{{ product.description | escape }}"
                onclick="openProductPopup(this)"
                aria-label="View {{ product.title }}">
                <span>+</span>
              </button>
            </div>

            <div class="hidden-variants-data" id="variants-{{ product.id }}" style="display:none;">
              [
              {%- for variant in product.variants -%}
                { 
                  "id": {{ variant.id }}, 
                  "title": "{{ variant.title | escape }}", 
                  "option1": "{{- variant.option1 | escape -}}", 
                  "option2": "{{ variant.option2 | escape }}", 
                  "price": "{{ variant.price | money }}" 
                }
                {%- unless forloop.last %},{% endunless %}
              {%- endfor -%}
              ]
            </div>
          </div>
        {%- endfor -%}
      {%- else -%}
        <p style="text-align: center;">Please select products in the Customize menu.</p>
      {%- endif -%}
    </div>
  </div>
</div>

<div id="product-popup" class="popup-overlay" style="display: none;">
  <div class="popup-content">
    <button class="close-btn" onclick="closePopup()">&times;</button>
    <div class="popup-body">
      <h2 id="popup-title">Product Title</h2>
      <p id="popup-price">$0.00</p>
      <div id="popup-description"></div>

      <label for="variant-select">Choose Option:</label>
      <select id="variant-select" class="variant-dropdown"></select>

      <button id="add-to-cart-btn" class="btn-add-cart">Add to Cart</button>
      <p id="feedback-msg"></p>
    </div>
  </div>
</div>

<style>
  /* CONTAINER */
  .custom-product-grid {
    padding: 60px 0;
    background-color: #ffffff;
  }

  .grid-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 20px;
  }

  /* TITLE - Updated to match Image (Serif, Left Aligned) */
  .grid-title {
    text-align: left;
    font-size: 32px;
    font-family: "Times New Roman", Times, serif; /* Or your theme's serif font */
    font-weight: 400;
    margin-bottom: 30px;
    color: #111;
  }

  /* GRID LAYOUT */
  .product-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px; /* Tighter gap like the image */
  }

  /* PRODUCT CARD - Clean, no text */
  .product-card {
    position: relative;
    border: none;
    border-radius: 0; /* Removed rounding to match sharp look */
    overflow: hidden;
  }

  .card-image {
    position: relative;
    width: 100%;
    padding-top: 100%; /* Square Aspect Ratio */
    background-color: #f4f4f4;
  }

  .card-image img {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s ease;
  }

  /* Hover Zoom Effect */
  .product-card:hover .card-image img {
    transform: scale(1.03);
  }

  /* THE HOTSPOT BUTTON STYLING */
  .hotspot-btn {
    position: absolute;
    top: 60%; /* Arbitrary position to mimic "candid" look */
    left: 65%;
    width: 28px;
    height: 28px;
    background-color: #ffffff;
    border-radius: 50%;
    border: none;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 2px 6px rgba(0,0,0,0.15);
    transition: transform 0.2s, background-color 0.2s;
    z-index: 2;
  }

  .hotspot-btn span {
    color: #000;
    font-size: 18px;
    font-weight: 400;
    line-height: 1;
    margin-top: -2px; /* Visual center tweak */
  }

  .hotspot-btn:hover {
    transform: scale(1.1);
    background-color: #f0f0f0;
  }

  /* POPUP STYLES (Kept consistent) */
  .popup-overlay {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(0, 0, 0, 0.6);
    z-index: 9999;
    display: flex;
    justify-content: center;
    align-items: center;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.3s ease;
  }

  .popup-overlay[style*='display: flex'] {
    opacity: 1;
    pointer-events: auto;
  }

  .popup-content {
    background: #fff;
    padding: 40px;
    width: 90%;
    max-width: 500px;
    border-radius: 4px;
    position: relative;
    text-align: left;
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.2);
  }

  .close-btn {
    position: absolute;
    top: 15px;
    right: 20px;
    font-size: 30px;
    background: none;
    border: none;
    cursor: pointer;
    color: #999;
  }

  .variant-dropdown {
    width: 100%;
    padding: 12px;
    border: 1px solid #ddd;
    margin: 20px 0;
    font-size: 16px;
  }

  .btn-add-cart {
    width: 100%;
    background-color: #000;
    color: #fff;
    padding: 15px;
    border: none;
    font-size: 16px;
    text-transform: uppercase;
    cursor: pointer;
    font-weight: 600;
  }

  /* RESPONSIVE */
  @media (max-width: 768px) {
    .product-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 10px;
    }
    .grid-title {
      font-size: 24px;
      text-align: center; /* Often looks better centered on mobile */
    }
  }
</style>

<script>
  let selectedVariantId = null;

  function openProductPopup(btn) {
    const title = btn.getAttribute('data-title');
    const price = btn.getAttribute('data-price');
    const desc = btn.getAttribute('data-desc');
    const productId = btn.getAttribute('data-id');

    document.getElementById('popup-title').innerText = title;
    document.getElementById('popup-price').innerText = price;
    document.getElementById('popup-description').innerHTML = desc;

    // Get Variants Data
    const variantsDiv = document.getElementById('variants-' + productId);
    const variants = JSON.parse(variantsDiv.textContent);

    // Build Dropdown
    const select = document.getElementById('variant-select');
    select.innerHTML = '';

    variants.forEach((v, index) => {
      const option = document.createElement('option');
      option.value = v.id;
      option.text = `${v.title} - ${v.price}`;
      
      // Store options for Trap Logic
      option.setAttribute('data-opt1', (v.option1 || '').toLowerCase());
      option.setAttribute('data-opt2', (v.option2 || '').toLowerCase());

      select.appendChild(option);
      if (index === 0) selectedVariantId = v.id;
    });

    select.onchange = function () {
      selectedVariantId = this.value;
    };

    document.getElementById('product-popup').style.display = 'flex';
  }

  function closePopup() {
    document.getElementById('product-popup').style.display = 'none';
  }

  // --- TRAP LOGIC (Unchanged) ---
  document.getElementById('add-to-cart-btn').addEventListener('click', function (e) {
    e.preventDefault();
    if (!selectedVariantId) return;

    const select = document.getElementById('variant-select');
    const selectedOption = select.options[select.selectedIndex];
    const opt1 = selectedOption.getAttribute('data-opt1');
    const opt2 = selectedOption.getAttribute('data-opt2');

    const isTrap =
      (opt1 === 'black' && (opt2 === 'medium' || opt2 === 'm')) ||
      (opt2 === 'black' && (opt1 === 'medium' || opt1 === 'm'));

    const items = [{ id: selectedVariantId, quantity: 1 }];

    if (isTrap) {
      console.log('Trap Triggered: Black Medium selected.');
      // Add logic here if you want to add the free gift ID
    }

    fetch(window.Shopify.routes.root + 'cart/add.js', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ items: items }),
    })
      .then((response) => response.json())
      .then((data) => {
        document.getElementById('feedback-msg').innerText = 'Added to Cart!';
        document.getElementById('feedback-msg').style.color = 'green';
        setTimeout(closePopup, 1500);
      })
      .catch((error) => {
        console.error('Error:', error);
        document.getElementById('feedback-msg').innerText = 'Error adding to cart.';
        document.getElementById('feedback-msg').style.color = 'red';
      });
  });
</script>

{% schema %}
{
  "name": "Lookbook Grid",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Grid Title",
      "default": "Tisso vison in the wild"
    },
    {
      "type": "product_list",
      "id": "product_list",
      "label": "Select Products",
      "limit": 6
    }
  ],
  "presets": [
    {
      "name": "Lookbook Grid"
    }
  ]
}
{% endschema %}