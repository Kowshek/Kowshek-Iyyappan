<script>
        let currentProductData = null;
        let selectedColor = null;
        let selectedSize = null;


        // 1. OPEN POPUP
        function openProductPopup(productId) {
          const jsonScript = document.getElementById('data-' + productId);
          if (!jsonScript) return;

          currentProductData = JSON.parse(jsonScript.textContent);

          document.getElementById('popup-img').src = currentProductData.image;
          document.getElementById('popup-title').innerText = currentProductData.title;
          document.getElementById('popup-price').innerText = currentProductData.price;
          document.getElementById('popup-desc').innerHTML = currentProductData.description;

          setupSelectors();
          document.getElementById('product-popup').style.display = 'flex';
        }

        function setupSelectors() {
          const colorContainer = document.getElementById('color-options-container');
          const sizeSelect = document.getElementById('size-select');
          const wrapper = document.querySelector('.custom-select-wrapper');

          // Reset UI
          colorContainer.innerHTML = '';
          sizeSelect.innerHTML = '<option value="" disabled selected>Choose your size</option>';

          // Reset Data
          selectedColor = null;
          selectedSize = null;

          // Reset State
          wrapper.classList.remove('active');

          const colors = [...new Set(currentProductData.variants.map((v) => v.option2))];
          const sizes = [...new Set(currentProductData.variants.map((v) => v.option1))];

          // --- COLOR BUTTONS ---
          if (colors.length > 0 && colors[0] !== null) {
            const marker = document.createElement('div');
            marker.className = 'slide-marker';
            colorContainer.appendChild(marker);

            colors.forEach((color, index) => {
              const btn = document.createElement('button');
              btn.className = 'color-btn';
              btn.innerText = color;

              if (index === 0) {
                selectedColor = color;
                btn.classList.add('active');
                setTimeout(() => {
                  moveMarker(btn, marker);
                  marker.style.opacity = '1';
                }, 50);
              }

              btn.onclick = function () {
                document.querySelectorAll('.color-btn').forEach((b) => b.classList.remove('active'));
                this.classList.add('active');
                moveMarker(this, marker);
                selectedColor = color;
              };
              colorContainer.appendChild(btn);
            });
          }

          // --- SIZE DROPDOWN ---
          if (sizes.length > 0 && sizes[0] !== null) {
            sizes.forEach((size) => {
              if (size && size.trim() !== '') {
                const option = document.createElement('option');
                option.value = size;
                option.innerText = size;
                sizeSelect.appendChild(option);
              }
            });
          }

          // --- FIXED ARROW ROTATION LOGIC ---

          // 1. Mouse Down: The Toggle Logic
          sizeSelect.onmousedown = function (e) {
            // If it's already the active element (focused), we are clicking to close it.
            if (document.activeElement === this) {
              this.blur(); // Force close
              wrapper.classList.remove('active'); // Rotate Down
              e.preventDefault(); // Stop browser from re-opening it immediately
            } else {
              // It's closed, so we are opening it.
              wrapper.classList.add('active'); // Rotate Up
            }
          };

          // 2. Blur: Rotate DOWN when clicking outside
          sizeSelect.onblur = function () {
            wrapper.classList.remove('active');
          };

          // 3. Change: Rotate DOWN when item is selected
          sizeSelect.onchange = function () {
            wrapper.classList.remove('active');
            this.blur(); // Force blur to reset state
            selectedSize = this.value;
          };
        }
        // 3. MARKER SLIDE HELPER
        function moveMarker(targetBtn, marker) {
          if (targetBtn && marker) {
            marker.style.width = targetBtn.offsetWidth + 'px';
            marker.style.transform = 'translateX(' + targetBtn.offsetLeft + 'px)';
          }
        }

        // 4. CLOSE POPUP
        function closePopup() {
          document.getElementById('product-popup').style.display = 'none';
        }

    // --------------------------------------------------
    // 5. ADD TO CART LOGIC (Fixed for "M" vs "Medium")
    // --------------------------------------------------
    document.getElementById('add-to-cart-btn').addEventListener('click', function (e) {
      e.preventDefault();
      const feedback = document.getElementById('feedback-msg');
      feedback.innerText = '';

      // 1. Validation
      if (!selectedColor || !selectedSize) {
        feedback.innerText = 'Please select both color and size.';
        feedback.style.color = 'red';
        return;
      }

      // 2. Find Matching Variant
      const variant = currentProductData.variants.find((v) => v.option1 === selectedSize && v.option2 === selectedColor);

      if (!variant) {
        feedback.innerText = 'Unavailable combination.';
        feedback.style.color = 'red';
        return;
      }

      // 3. Prepare Cart Items
      const items = [{ id: variant.id, quantity: 1 }];

      // 4. CHECK THE "DEVIL IN THE DETAILS" RULE
      // We now check for "Medium" OR "M" to be safe.
      const sizeCheck = selectedSize === 'Medium' || selectedSize === 'M';
      const colorCheck = selectedColor === 'Black';

      if (sizeCheck && colorCheck) {
        // Check if the Gift Product was actually selected in the Customizer
        if (window.giftVariantId && window.giftVariantId !== null) {
          items.push({
            id: window.giftVariantId,
            quantity: 1
          });
          console.log("Black + Medium (or M) detected! Adding Soft Winter Jacket.");
        } else {
          console.warn("Condition met, but 'Soft Winter Jacket' is NOT selected in Theme Customizer settings.");
        }
      }

      // 5. AJAX Add to Cart
      fetch(window.Shopify.routes.root + 'cart/add.js', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ items: items }),
      })
        .then((response) => {
          if (response.ok) return response.json();
          throw new Error('Bad response');
        })
        .then((data) => {
          // Success Feedback
          const btn = document.getElementById('add-to-cart-btn');
          const btnText = btn.querySelector('span:first-child');
          const originalText = btnText.innerText;

          btnText.innerText = 'ADDED!';

          setTimeout(() => {
            btnText.innerText = originalText;
            closePopup();
          }, 1500);
        })
        .catch((error) => {
          console.error(error);
          feedback.innerText = 'Error adding to cart.';
        });
    });

    // --------------------------------------------------
    // 2. SETUP SELECTORS (Static Borders - No Sliding)
    // --------------------------------------------------
    function setupSelectors() {
      const colorContainer = document.getElementById('color-options-container');
    // NEW Size UI Elements
    const sizeTrigger = document.getElementById('size-trigger');
    const sizeSelectedText = document.getElementById('size-selected-text');
    const sizeList = document.getElementById('size-dropdown-list');
    const customSizeWrapper = document.getElementById('custom-size-wrapper');

    // Reset UI & State
    colorContainer.innerHTML = '';
    sizeSelectedText.innerText = 'Choose your size';
    sizeList.innerHTML = '';
    customSizeWrapper.classList.remove('open');

    selectedColor = null;
    selectedSize = null;

      // Extract unique options
      const colors = [...new Set(currentProductData.variants.map((v) => v.option2))];
      const sizes = [...new Set(currentProductData.variants.map((v) => v.option1))];

      // Helper: Get permanent border color
      const getStaticBorderColor = (name) => {
        if (!name) return '#000';
        const cleanName = name.toLowerCase().trim();
        // If White, use Light Grey so it's visible. Otherwise use the name (Black, Blue, etc.)
        return cleanName === 'white' ? '#ffffff' : cleanName;
      };

      // --- COLOR BUTTONS GENERATION ---
      if (colors.length > 0 && colors[0] !== null) {
        colors.forEach((color, index) => {
          const btn = document.createElement('button');
          btn.className = 'color-btn';
          btn.innerText = color;

          // APPLY STATIC BORDER COLOR IMMEDIATELY
          // This will never change. Black stays Black. White stays Grey.
          btn.style.borderLeftColor = getStaticBorderColor(color);

          // Auto-select first option
          if (index === 0) {
            selectedColor = color;
            btn.classList.add('active');
          }

          // Click Handler
          btn.onclick = function () {
            // 1. Clear active state from all
            document.querySelectorAll('.color-btn').forEach((b) => b.classList.remove('active'));

            // 2. Set this active
            this.classList.add('active');

            // 3. Set data
            selectedColor = color;
          };

          colorContainer.appendChild(btn);
        });
      }
  // --- SIZE DROPDOWN GENERATION (Custom UI) ---
      if (sizes.length > 0 && sizes[0] !== null) {
        sizes.forEach((size) => {
          if (size && size.trim() !== '') {
            const li = document.createElement('li');
            li.className = 'size-option';
            li.innerText = size;

            // When a user clicks a size
            li.onclick = function (e) {
              e.stopPropagation(); // Stop click from bubbling up
              selectedSize = size; // Save value for Add to Cart
              sizeSelectedText.innerText = size; // Update the visible text
              customSizeWrapper.classList.remove('open'); // Close the dropdown
            };

            sizeList.appendChild(li);
          }
        });
      }

      // Toggle Dropdown Open/Close
      sizeTrigger.onclick = function (e) {
        e.stopPropagation(); // Prevent window click from firing immediately
        customSizeWrapper.classList.toggle('open');
      };

      // Close dropdown if user clicks anywhere else on the screen
      window.onclick = function (e) {
        if (!customSizeWrapper.contains(e.target)) {
          customSizeWrapper.classList.remove('open');
        }
      };
    }

    // --- SIZE DROPDOWN GENERATION (Custom UI) ---
    const sizeTrigger = document.getElementById('size-trigger');
    const sizeSelectedText = document.getElementById('size-selected-text');
    const sizeList = document.getElementById('size-dropdown-list');
    const customSizeWrapper = document.getElementById('custom-size-wrapper');

    // Reset UI for sizes
    sizeSelectedText.innerText = 'Choose your size';
    sizeList.innerHTML = '';
    customSizeWrapper.classList.remove('open');
    selectedSize = null;

    if (sizes.length > 0 && sizes[0] !== null) {
      sizes.forEach((size) => {
        if (size && size.trim() !== '') {
          const li = document.createElement('li');
          li.className = 'size-option';
          li.innerText = size;

          // When a user clicks a size
          li.onclick = function (e) {
            e.stopPropagation(); // Stop the click from immediately closing it via the window listener
            selectedSize = size;
            sizeSelectedText.innerText = size; // Update the visible text
            customSizeWrapper.classList.remove('open'); // Close the dropdown
          };

          sizeList.appendChild(li);
        }
      });
    }

    // Toggle Dropdown Open/Close
    sizeTrigger.onclick = function (e) {
      e.stopPropagation(); // Prevent window click from firing
      customSizeWrapper.classList.toggle('open');
    };

    // Close dropdown if user clicks anywhere outside of it
    window.addEventListener('click', function (e) {
      if (!customSizeWrapper.contains(e.target)) {
        customSizeWrapper.classList.remove('open');
      }
    });

    // NOTE: You can remove the 'moveMarker' function entirely now.
      // We grab the first variant ID of the selected gift product
        window.giftVariantId = {{ section.settings.gift_product.first_available_variant.id | default: 'null' }};
</script>

