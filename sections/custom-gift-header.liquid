<div class="gift-header-wrapper section-{{ section.id }}">
  <div class="gift-header-container">
    <div class="gh-logo">
      <a href="{{ routes.root_url }}">
        {{ section.settings.logo_text }}
      </a>
    </div>

    <div class="gh-center-text">
      {{ section.settings.center_text }}
    </div>

    <a href="{{ section.settings.btn_link }}" class="gh-button">
      <span>{{ section.settings.btn_text }}</span>
      <svg width="24" height="14" viewBox="0 0 24 14" fill="none" xmlns="http://www.w3.org/2000/svg">
        <path d="M17 1L23 7L17 13M23 7H0" stroke="black" stroke-width="1.5"/>
      </svg>
    </a>
  </div>
</div>

<style>
  /* 1. IMPORT JOST FONT FROM GOOGLE */
  @import url('https://fonts.googleapis.com/css2?family=Jost:wght@400;500;700&display=swap');

  /* Wrapper for Background Color */
  .gift-header-wrapper {
    background-color: {{ section.settings.bg_color }};
    width: 100%;
    border-bottom: 1px solid #e5e5e5;
  }

  /* Container for Content alignment */
  .gift-header-container {
    max-width: 100% !important;
    margin: 0;
    padding: 0 40px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    height: 70px !important;
  }

  /* 2. LOGO STYLE (Bold, Uppercase) */
  .gh-logo a {
    font-family: 'Jost', sans-serif;
    font-weight: 500 !important;
    font-size: 30px !important;
    letter-spacing: 0px !important;
    text-transform: uppercase;
    color: #000;
    text-decoration: none;
  }

  /* 3. CENTER TEXT STYLE (Regular, Normal Case) */
  .gh-center-text {
    font-family: 'Jost', sans-serif; /* CHANGED TO JOST */
    font-size: 19px !important;
    color: #111;
    font-weight: 400; /* Regular weight */
    {% comment %} letter-spacing: 0.5px; {% endcomment %}
  }

  /* 4. BUTTON STYLE (Medium, Uppercase) */
  .gh-button {
    background-color: #fffa38;
    color: #000;
    padding: 10px 20px 10px 35px !important;
    display: flex;
    align-items: center;
    gap: 35px !important;
    text-decoration: none;
    font-family: 'Jost', sans-serif;
    font-size: 20px !important;
    font-weight: 400;
    text-transform: uppercase;
    letter-spacing: 1px;
    transition: opacity 0.2s;
  }

  .gh-button:hover {
    opacity: 0.8;
  }

  .gh-button svg {
    display: block;
    width: 30px;
    height: auto;
  }

  /* Mobile Responsive */
  @media (max-width: 768px) {
    .gift-header-container {
      flex-direction: column;
      height: auto;
      padding: 15px 20px;
      gap: 15px;
      text-align: center;
    }
    .gh-logo a { font-size: 22px; }
    .gh-center-text { font-size: 14px; margin-bottom: 5px; }
    .gh-button { width: 100%; justify-content: center; }
  }
</style>
{% schema %}
{
  "name": "Gift Header Bar",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "logo_text",
      "label": "Logo Text",
      "default": "TISSO VISON"
    },
    {
      "type": "text",
      "id": "center_text",
      "label": "Center Message",
      "default": "Find the ideal gift for your loved ones."
    },
    {
      "type": "text",
      "id": "btn_text",
      "label": "Button Text",
      "default": "CHOOSE GIFT"
    },
    {
      "type": "url",
      "id": "btn_link",
      "label": "Button Link"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#F5F5F5"
    },
    {
      "type": "color",
      "id": "btn_color",
      "label": "Button Color",
      "default": "#FFFA38"
    }
  ],
  "presets": [
    {
      "name": "Gift Header Bar"
    }
  ]
}
{% endschema %}
