

<div class="custom-banner-wrapper">
  
  {% comment %} <div class="gift-header-wrapper">
    <div class="gift-header-container">
      <div class="gh-logo">
        <a href="{{ routes.root_url }}">{{ section.settings.top_logo_text }}</a>
      </div>
      <div class="gh-center-text">{{ section.settings.top_center_text }}</div>
      <a href="{{ section.settings.top_btn_link }}" class="gh-button">
        <span>{{ section.settings.top_btn_text }}</span>
        <svg width="24" height="14" viewBox="0 0 24 14" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M17 1L23 7L17 13M23 7H0" stroke="black" stroke-width="1.5"/>
        </svg>
      </a>
    </div>
  </div> {% endcomment %}

  <div class="gift-guide-section">
    
    <div class="gg-image-border top-border">
      {%- if section.settings.top_image != blank -%}
        <img
          src="{{ section.settings.top_image | image_url: width: 2000 }}"
          alt="Top Border"
          loading="lazy"
          width="2000"
          height="400"
        >
      {%- endif -%}
    </div>

    <div class="gg-content-wrapper">
      <div class="gg-content">
        <h1 class="gg-heading">{{ section.settings.hero_heading }}</h1>
        <div class="gg-description">{{ section.settings.hero_text }}</div>
        <a href="{{ section.settings.hero_btn_link }}" class="gg-button">
          <span>{{ section.settings.hero_btn_label }}</span>
          <svg width="24" height="12" viewBox="0 0 24 12" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M18 1L23 6L18 11M23 6H0" stroke="white" stroke-width="1.5"/>
          </svg>
        </a>
      </div>
    </div>

    <div class="gg-image-border bottom-border">
      {%- if section.settings.bottom_image != blank -%}
        <img
          src="{{ section.settings.bottom_image | image_url: width: 2000 }}"
          alt="Bottom Border"
          loading="lazy"
          width="2000"
          height="400"
        >
      {%- endif -%}
    </div>

  </div>
</div>

<style>
  @import url('https://fonts.googleapis.com/css2?family=Jost:wght@400;500;600;700&family=Lustria&display=swap');

  .custom-banner-wrapper { width: 100%; position: relative; }

  /* --- HEADER BAR STYLES --- */
  .gift-header-wrapper {
    background-color: {{ section.settings.top_bg_color }};
    width: 100%; border-bottom: 1px solid #e5e5e5; position: relative; z-index: 10;
  }
  .gift-header-container {
    max-width: 1400px; margin: 0 auto; padding: 0 40px;
    display: flex; justify-content: space-between; align-items: center; height: 60px;
  }
  .gh-logo a { font-family: 'Jost', sans-serif; font-weight: 700; font-size: 20px; letter-spacing: 2px; text-transform: uppercase; color: #000; text-decoration: none; }
  .gh-center-text { font-family: 'Jost', sans-serif; font-size: 15px; color: #111; font-weight: 400; letter-spacing: 0.5px; }
  .gh-button {
    background-color: {{ section.settings.top_btn_color }}; color: #000; padding: 10px 25px;
    display: flex; align-items: center; gap: 12px; text-decoration: none;
    font-family: 'Jost', sans-serif; font-size: 13px; font-weight: 500; text-transform: uppercase; letter-spacing: 1px; transition: opacity 0.2s;
  }
  .gh-button:hover { opacity: 0.8; }
  .gh-button svg { display: block; width: 18px; height: auto; }

  /* --- HERO BANNER STYLES --- */
  .gift-guide-section {
    position: relative;
    width: 100%;
    min-height: 700px; /* Taller height to fit both images + text */
    overflow: hidden;
    background-color: #fff;
    display: flex;
    align-items: center; /* Centers content vertically */
    justify-content: flex-start;
  }

  /* SPLIT IMAGES (Absolute Positioning) */
  .gg-image-border {
    position: absolute;
    left: 0;
    width: 100%;
    z-index: 1;
    pointer-events: none; /* Let clicks pass through to text if overlapping */
  }
  .gg-image-border img {
    width: 100%;
    height: auto;
    display: block;
  }

  .top-border { top: 0; }
  .bottom-border { bottom: 0; }

  /* CONTENT */
  .gg-content-wrapper {
    position: relative; 
    z-index: 2; 
    width: 100%; 
    max-width: 1400px; 
    margin: 0 auto; 
    padding: 0 50px;
  }
  
  .gg-content { max-width: 550px; }

  .gg-heading {
    font-family: 'Jost', sans-serif; font-weight: 600; font-size: 64px; line-height: 1.1; color: #000; margin: 0 0 25px 0; letter-spacing: -1px;
  }
  .gg-description {
    font-family: 'Jost', sans-serif; font-size: 18px; line-height: 1.6; color: #111; margin-bottom: 40px; font-weight: 400;
  }
  .gg-button {
    display: inline-flex; align-items: center; justify-content: space-between;
    background-color: #000; color: #fff; text-decoration: none; padding: 18px 35px; min-width: 180px;
    font-family: 'Jost', sans-serif; font-size: 14px; text-transform: uppercase; letter-spacing: 1px; font-weight: 500; transition: opacity 0.2s ease;
  }
  .gg-button:hover { opacity: 0.85; }
  .gg-button svg { margin-left: 15px; width: 20px; }

  /* MOBILE RESPONSIVE */
  @media (max-width: 768px) {
    .gift-header-container { flex-direction: column; height: auto; padding: 15px 20px; gap: 15px; text-align: center; }
    
    .gift-guide-section { min-height: 500px; padding: 40px 0; justify-content: center; }
    .gg-image-border img { height: 150px; object-fit: cover; } /* Crop images slightly on mobile to save space */
    
    .gg-content-wrapper { padding: 0 25px; text-align: center; }
    .gg-content { margin: 0 auto; } /* Center text on mobile */
    .gg-heading { font-size: 42px; }
    .gg-button { width: 100%; justify-content: center; }
  }
</style>

{% schema %}
{
  "name": "Custom Banner (Split)",
  "settings": [
    { "type": "header", "content": "Top Header Bar" },
    { "type": "text", "id": "top_logo_text", "label": "Logo Text", "default": "TISSO VISON" },
    { "type": "text", "id": "top_center_text", "label": "Center Message", "default": "Find the ideal gift for your loved ones." },
    { "type": "text", "id": "top_btn_text", "label": "Header Button Text", "default": "CHOOSE GIFT" },
    { "type": "url", "id": "top_btn_link", "label": "Header Button Link" },
    { "type": "color", "id": "top_bg_color", "label": "Header Background", "default": "#F5F5F5" },
    { "type": "color", "id": "top_btn_color", "label": "Header Button Color", "default": "#FFFA38" },

    { "type": "header", "content": "Banner Images" },
    { "type": "image_picker", "id": "top_image", "label": "Top Border Image (Frame.png)" },
    { "type": "image_picker", "id": "bottom_image", "label": "Bottom Border Image (Frame 1.png)" },

    { "type": "header", "content": "Banner Content" },
    { "type": "text", "id": "hero_heading", "label": "Heading", "default": "The Gift Guide" },
    { "type": "textarea", "id": "hero_text", "label": "Description", "default": "Discover Joy: Your Ultimate Holiday Gift Destination." },
    { "type": "text", "id": "hero_btn_label", "label": "Button Label", "default": "SHOP NOW" },
    { "type": "url", "id": "hero_btn_link", "label": "Button Link" }
  ],
  "presets": [
    { "name": "Custom Banner (Split)" }
  ]
}
{% endschema %}