{% comment %}
  CUSTOM GIFT GUIDE BANNER
  - Matches "The Gift Guide" reference exactly.
  - Features: Line-art background, bold typography, arrow button.
{% endcomment %}

<div class="gift-guide-section">
  <div class="gg-background">
    {%- if section.settings.bg_image != blank -%}
      <img
        src="{{ section.settings.bg_image | image_url: width: 2000 }}"
        alt="Gift Guide Background"
        class="gg-bg-img"
        loading="lazy"
        width="2000"
        height="1000"
      >
    {%- else -%}
      {{ 'lifestyle-2' | placeholder_svg_tag: 'gg-placeholder' }}
    {%- endif -%}
  </div>

  <div class="gg-content-wrapper">
    <div class="gg-content">
      
      <h1 class="gg-heading">
        {{ section.settings.heading | default: "The Gift Guide" }}
      </h1>

      <div class="gg-description">
        {{ section.settings.text | default: "Discover Joy: Your Ultimate Holiday Gift Destination. Explore our curated selection and find the perfect gifts to delight your loved ones this holiday season." }}
      </div>

      <a href="{{ section.settings.btn_link }}" class="gg-button">
        <span>{{ section.settings.btn_label | default: "SHOP NOW" }}</span>
        <svg width="24" height="12" viewBox="0 0 24 12" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M18 1L23 6L18 11M23 6H0" stroke="white" stroke-width="1.5"/>
        </svg>
      </a>

    </div>
  </div>
</div>

<style>
  /* 1. IMPORT FONTS (Jost + Lustria) */
  @import url('https://fonts.googleapis.com/css2?family=Jost:wght@400;500;600&family=Lustria&display=swap');

  /* 2. MAIN SECTION LAYOUT */
  .gift-guide-section {
    position: relative;
    width: 100%;
    height: 600px; /* Adjust based on preference */
    overflow: hidden;
    background-color: #fff;
    display: flex;
    align-items: center; /* Vertically center content */
  }

  /* 3. BACKGROUND IMAGE */
  .gg-background {
    position: absolute;
    top: 0; left: 0;
    width: 100%; height: 100%;
    z-index: 1;
  }
  
  .gg-bg-img {
    width: 100%;
    height: 100%;
    object-fit: cover; /* Ensures it fills space */
    object-position: center; 
  }

  .gg-placeholder {
    width: 100%; height: 100%;
    background: #f0f0f0;
    opacity: 0.5;
  }

  /* 4. CONTENT WRAPPER */
  .gg-content-wrapper {
    position: relative;
    z-index: 2; /* Sits on top of background */
    width: 100%;
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 50px;
    display: flex;
    justify-content: flex-start; /* Aligns content to the left */
  }

  .gg-content {
    max-width: 550px; /* Limits text width like reference */
    background: rgba(255, 255, 255, 0.9); /* Slight white backing for readability if needed */
    padding: 40px; /* Spacing around text */
    /* Remove background/padding above if your image has clear whitespace */
    background: transparent; 
    padding: 0;
  }

  /* 5. TYPOGRAPHY (Exact Match) */
  .gg-heading {
    font-family: 'Jost', sans-serif;
    font-weight: 600; /* Bold/Semi-bold */
    font-size: 64px; /* Large scale */
    line-height: 1.1;
    color: #000;
    margin: 0 0 25px 0;
    letter-spacing: -1px;
  }

  .gg-description {
    font-family: 'Jost', sans-serif;
    font-size: 18px;
    line-height: 1.6;
    color: #111;
    margin-bottom: 40px;
    font-weight: 400;
  }

  /* 6. BUTTON (Black with Arrow) */
  .gg-button {
    display: inline-flex;
    align-items: center;
    justify-content: space-between;
    background-color: #000;
    color: #fff;
    text-decoration: none;
    padding: 18px 35px;
    min-width: 180px;
    font-family: 'Jost', sans-serif;
    font-size: 14px;
    text-transform: uppercase;
    letter-spacing: 1px;
    font-weight: 500;
    transition: opacity 0.2s ease;
  }

  .gg-button:hover {
    opacity: 0.85;
  }

  .gg-button svg {
    margin-left: 15px;
    width: 20px;
  }

  /* MOBILE RESPONSIVE */
  @media (max-width: 768px) {
    .gift-guide-section { height: auto; padding: 60px 0; }
    .gg-content-wrapper { padding: 0 25px; }
    .gg-heading { font-size: 42px; }
    .gg-description { font-size: 16px; }
    .gg-button { width: 100%; justify-content: center; }
  }
</style>

{% schema %}
{
  "name": "Gift Guide Banner",
  "settings": [
    {
      "type": "image_picker",
      "id": "bg_image",
      "label": "Background Image"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "The Gift Guide"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Description",
      "default": "Discover Joy: Your Ultimate Holiday Gift Destination. Explore our curated selection and find the perfect gifts to delight your loved ones this holiday season."
    },
    {
      "type": "text",
      "id": "btn_label",
      "label": "Button Label",
      "default": "SHOP NOW"
    },
    {
      "type": "url",
      "id": "btn_link",
      "label": "Button Link"
    }
  ],
  "presets": [
    {
      "name": "Gift Guide Banner"
    }
  ]
}
{% endschema %}